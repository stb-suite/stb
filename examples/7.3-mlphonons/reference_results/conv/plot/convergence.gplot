# --- STB Plot Configuration ---
# Generated by stb-mlphonons: gnuplot convergence.gplot
set terminal pdfcairo enhanced color font "Arial,10" size 16,4.6
set output "convergence.pdf"
set encoding utf8
set grid
set key font ",8"
set multiplot layout 1,3
set xtics ("{/Symbol G}" 0.000000, "X" 0.182474, "W" 0.273711, "K" 0.338225, "{/Symbol G}" 0.531768, "L" 0.689795, "U" 0.801537, "W" 0.866051, "L" 0.995079, "K" 1.106821, "U" 1.106821, "X" 1.171336)
set ylabel "Frequency (THz)"
set title "Bands per supercell"
set key bottom right
plot for [i=2:7] "conv_bands_1x1x1.dat" using 1:i with lines lw 1.2 lc rgb "#0072B2" title (i==2 ? "1x1x1" : ""), \
     for [i=2:7] "conv_bands_2x2x2.dat" using 1:i with lines lw 1.2 lc rgb "#D55E00" title (i==2 ? "2x2x2" : ""), \
     for [i=2:7] "conv_bands_3x3x3.dat" using 1:i with lines lw 1.2 lc rgb "#009E73" title (i==2 ? "3x3x3" : ""), \
     for [i=2:7] "conv_bands_4x4x4.dat" using 1:i with lines lw 1.2 lc rgb "#CC79A7" title (i==2 ? "4x4x4" : "")
set xtics autofreq
set logscale x
set xlabel "atoms in the supercell"
set key top right
set ylabel "RMSE vs 4x4x4 (THz)"
set title "Frequencies"
plot "convergence.dat" using 2:7 with linespoints pt 7 lw 2 lc rgb "#0072B2" notitle
set ylabel "C_V at 300 K (k_B/atom)"
set y2label "S at 300 K (k_B/atom)"
set ytics nomirror
set y2tics
set title "Thermal properties"
plot "convergence.dat" using 2:9 with linespoints pt 7 lw 2 lc rgb "#0072B2" title "C_V", "" using 2:10 axes x1y2 with linespoints pt 5 lw 2 lc rgb "#D55E00" title "S"
unset multiplot
