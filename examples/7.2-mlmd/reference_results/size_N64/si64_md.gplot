# --- STB Plot Configuration ---
# Generated by stb-mlmd: gnuplot si64_md.gplot
set terminal pdfcairo enhanced color font "Arial,10" size 15,8.2
set output "si64_md.pdf"
set multiplot layout 2,3 title "stb-mlmd NVT 300 K -- Si64 (64 atoms), mlff\\_model\\_compiled.model"
set grid
set key top right font ",8"

set xlabel "time (ps)"
set ylabel "temperature (K)"
set title "Temperature"
plot "si64_md_thermo.dat" using ($1/1000):2 with lines lw 1 lc rgb "#0072B2" title "T(t)", 300 with lines dt 2 lc rgb "#777777" title "target"
set ylabel "energy - mean (meV/atom)"
set title "Energies"
plot "si64_md_thermo.dat" using ($1/1000):(($3-(-114.97627625))*1000) with lines lw 1 lc rgb "#0072B2" title "E_{pot}", "" using ($1/1000):(($5-(-114.93745471))*1000) with lines lw 1.5 lc rgb "#D55E00" title "E_{tot}"
set ylabel "pressure (GPa)"
set title "Pressure"
plot "si64_md_thermo.dat" using ($1/1000):6 with lines lw 1 lc rgb "#009E73" title "P(t)"
set ylabel "shortest distance (Ang)"
set title "Closest pair"
plot "si64_md_thermo.dat" using ($1/1000):11 with lines lw 1 lc rgb "#CC79A7" title "d_{min}", 1.8519 with lines dt 2 lc rgb "#D55E00" title "shortest in training"
set xlabel "r (Ang)"
set ylabel "g(r)"
set title "Radial distribution function"
plot "si64_md_rdf.dat" using 1:2 with lines lw 1.5 lc rgb "#0072B2" title "g(r)"
set xlabel "lag time (ps)"
set ylabel "MSD (Ang^2)"
set title "Mean-square displacement"
plot "si64_md_msd.dat" using ($1/1000):2 with lines lw 1.5 lc rgb "#0072B2" title "all atoms"
unset multiplot
