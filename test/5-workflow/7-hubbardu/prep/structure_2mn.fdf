# Rocksalt MnO, 2 formula units (2 Mn + 2 O) -- the two Mn atoms are related
# by a pure lattice translation (symmetrically equivalent), matching the real
# case that exposed the "perturbing every atom of a multi-atom species at
# once" bug: --species Mn must require --atom-index here.

NumberOfSpecies    2
NumberofAtoms      4

%block ChemicalSpeciesLabel
 1   25   Mn
 2   8   O
%endblock ChemicalSpeciesLabel

LatticeConstant 1.0 Ang

AtomicCoordinatesFormat  Fractional

%block LatticeVectors
 0.00000000   4.40800000   4.40800000
 2.20400000   0.00000000   2.20400000
 2.20400000   2.20400000   0.00000000
%endblock LatticeVectors

%block AtomicCoordinatesAndAtomicSpecies
  0.00000000   0.00000000   0.00000000   1
  0.50000000   0.00000000   0.00000000   1
  0.25000000   0.50000000   0.50000000   2
  0.75000000   0.50000000   0.50000000   2
%endblock AtomicCoordinatesAndAtomicSpecies
