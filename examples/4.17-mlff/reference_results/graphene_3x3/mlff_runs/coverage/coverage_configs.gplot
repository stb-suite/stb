# --- STB Plot Configuration ---
# Generated by stb-mlff
reset
set terminal pdfcairo enhanced color font "Arial,12" size 15,4.8
set output "coverage_configs.pdf"
set multiplot layout 1,3 title "Sampled configurations (stb-mlff)"
set grid lc rgb "#dddddd"
set key outside top center horizontal
set offsets graph 0.05, graph 0.05, graph 0.05, graph 0.05

set xlabel "Volume change (%)"
set ylabel "RMS displacement from reference (Ang)"
plot "coverage_configs.dat" index 0 using 1:2 with points pt 7 ps 1.2 lc rgb "#2255cc" title "training", "" index 1 using 1:2 with points pt 5 ps 1.2 lc rgb "#cc5522" title "test"

set xlabel "Max displacement (Ang)"
set ylabel "Shortest distance (Ang)"
plot "coverage_configs.dat" index 0 using 3:4 with points pt 7 ps 1.2 lc rgb "#2255cc" title "training", "" index 1 using 3:4 with points pt 5 ps 1.2 lc rgb "#cc5522" title "test", 1.1470 with lines dt 2 lc rgb "#bb9900" title "80% ref. d_{min}", 0.9319 with lines dt 2 lc rgb "#cc0000" title "65%"

set xlabel "Shortest distance (Ang)"
set ylabel "Foundation-model max force (eV/Ang)"
plot "coverage_configs.dat" index 0 using 4:6 with points pt 7 ps 1.2 lc rgb "#2255cc" title "training", "" index 1 using 4:6 with points pt 5 ps 1.2 lc rgb "#cc5522" title "test"

unset multiplot
