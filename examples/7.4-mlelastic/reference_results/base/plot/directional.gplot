# --- STB Plot Configuration ---
# Generated by stb-mlelastic: gnuplot directional.gplot
set terminal pdfcairo enhanced color font "Arial,9" size 11,5.5
set output "directional.pdf"
set polar
set angles degrees
set size square
set grid polar 30
unset border
unset xtics
unset ytics
set key bottom right font ",7"
set multiplot layout 1,2
set title "Young's modulus E (GPa), xy plane"
plot "directional.dat" using 1:2 with lines lw 2 lc rgb "#2a6fdb" title "fine-tuned", \
     "directional.dat" using 1:6 with lines lw 2 lc rgb "#d9480f" title "MACE-MP-0 medium"
set title "Young's modulus E (GPa), plane of z and x+y"
plot "directional.dat" using 1:4 with lines lw 2 lc rgb "#2a6fdb" title "fine-tuned", \
     "directional.dat" using 1:8 with lines lw 2 lc rgb "#d9480f" title "MACE-MP-0 medium"
unset multiplot
