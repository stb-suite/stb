# --- STB Plot Configuration ---
# Generated by stb-mlphonons: gnuplot thermal.gplot
set terminal pdfcairo enhanced color font "Arial,10" size 14,4.4
set output "thermal.pdf"
set encoding utf8
set grid
set key font ",8"
set multiplot layout 1,3
set xlabel "Temperature (K)"
set key top right
set ylabel "F_{vib} (meV/atom)"
set title "Vibrational free energy"
plot "thermal_0.dat" using 1:6 with lines lw 2 lc rgb "#0072B2" title "Fine-tuned", "thermal_1.dat" using 1:6 with lines lw 2 lc rgb "#D55E00" title "Foundation (medium)"
set key top left
set ylabel "S (k_B/atom)"
set title "Entropy"
plot "thermal_0.dat" using 1:7 with lines lw 2 lc rgb "#0072B2" title "Fine-tuned", "thermal_1.dat" using 1:7 with lines lw 2 lc rgb "#D55E00" title "Foundation (medium)"
set key bottom right
set ylabel "C_V (k_B/atom)"
set title "Heat capacity"
plot "thermal_0.dat" using 1:8 with lines lw 2 lc rgb "#0072B2" title "Fine-tuned", "thermal_1.dat" using 1:8 with lines lw 2 lc rgb "#D55E00" title "Foundation (medium)", 3 with lines dt 2 lc rgb "gray" title "Dulong-Petit"
unset multiplot
