# Isolated carbon atom, 20 Ang vacuum cube -- 0D fixture (vacuum on all 3
# axes), reused by ../analysis/test.sh to exercise stb-opticalAnalysis's
# --dimensionality-correction molecular-polarizability (Clausius-Mossotti)
# path. Not a physically meaningful optical target on its own (a single
# atom has no interband optical response worth modeling) -- purely to
# exercise the tool's own 0D-detection/file-writing mechanics.
SystemName Isolated carbon atom (optical workflow 0D test fixture)
SystemLabel siesta

LatticeConstant 1.0 Ang
%block LatticeVectors
 20.0000000000   0.0000000000   0.0000000000
  0.0000000000  20.0000000000   0.0000000000
  0.0000000000   0.0000000000  20.0000000000
%endblock LatticeVectors

NumberOfSpecies 1
%block ChemicalSpeciesLabel
 1   6   C
%endblock ChemicalSpeciesLabel

NumberOfAtoms 1
AtomicCoordinatesFormat Fractional
%block AtomicCoordinatesAndAtomicSpecies
 0.5   0.5   0.5   1
%endblock AtomicCoordinatesAndAtomicSpecies
