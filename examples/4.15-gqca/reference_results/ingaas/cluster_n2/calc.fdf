%include config_extra.fdf

# calc.fdf template for the 3 cluster relaxations of the GQCA example
# (InGaAs / AlGaAs). stb-gqca never edits this file: the forced directives
# (relaxation, k-grid) go into each folder's config_extra.fdf instead.
SystemLabel siesta
%include structure.fdf

XC.functional GGA
XC.authors PBE
PAO.BasisType split
PAO.BasisSize DZP
PAO.EnergyShift 0.02 Ry
Mesh.Cutoff 250 Ry
Spin non-polarized

ElectronicTemperature 25 meV
MaxSCFIterations 150
DM.Tolerance 1.0e-5
DM.MixingWeight 0.1
DM.NumberPulay 5

# Relaxation controls (the run type / variable cell / k-grid are forced by stb-gqca)
MD.NumCGsteps 150
MD.MaxForceTol 0.02 eV/Ang
MD.MaxStressTol 0.1 GPa
