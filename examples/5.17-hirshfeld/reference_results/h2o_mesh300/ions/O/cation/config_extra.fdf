# Auto-generated by stb-hirshfeldIons -- keeps the (vacuum) cell fixed.
MD.VariableCell false
# Auto-generated by stb-hirshfeldIons -- an isolated-ion reference is a
# single-point evaluation, not something SIESTA should be relaxing.
MD.TypeOfRun          CG
MD.Steps              0
# Auto-generated by stb-hirshfeldIons -- a single ion in a large vacuum
# box needs no k-point sampling beyond Gamma.
kgrid.MonkhorstPack   [1  1  1]
# Auto-generated by stb-hirshfeldIons -- same MeshCutoff as this workflow's
# other folders.
MeshCutoff          300 Ry
# Auto-generated by stb-hirshfeldIons -- SIESTA must write the .RHO file
# for stb-hirshfeldAnalysis to read.
SaveRho             true
# Auto-generated by stb-hirshfeldIons -- same unconditional spin-polarized
# convention as stb-hirshfeldPrep's own neutral-atom folders.
Spin                polarized
# Auto-generated by stb-hirshfeldIons -- one of the two ion references
# (CATION) always computed for this species (see module docstring for
# why Stage 3 needs both, not just whichever sign a pass-0 vote favors).
NetCharge            +1.0
