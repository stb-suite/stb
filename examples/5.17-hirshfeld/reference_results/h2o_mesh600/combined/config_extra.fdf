# Auto-generated by stb-hirshfeldPrep -- keeps the cell fixed.
MD.VariableCell false
# Auto-generated by stb-hirshfeldPrep -- a single-point density evaluation,
# not something SIESTA should be relaxing.
MD.TypeOfRun          CG
MD.Steps              0
# Auto-generated by stb-hirshfeldPrep -- same MeshCutoff as every other
# folder this workflow writes/reads, so every .RHO ends up on a comparably
# resolved real-space grid.
MeshCutoff          600 Ry
# Auto-generated by stb-hirshfeldPrep -- SIESTA must write the .RHO file
# for stb-hirshfeldIons/Analysis to read.
SaveRho             true
# Auto-generated by stb-hirshfeldPrep -- native SIESTA Hirshfeld/Voronoi
# charges (read via stb-nativecharges) as a free cross-check against the
# Hirshfeld-I result stb-hirshfeldAnalysis converges to, from this SAME run.
Charge.Hirshfeld end
Charge.Voronoi end
