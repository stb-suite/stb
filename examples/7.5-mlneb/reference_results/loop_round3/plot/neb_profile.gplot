# --- STB Plot Configuration ---
# Generated by stb-mlneb: gnuplot neb_profile.gplot
set terminal pdfcairo enhanced color font "Arial,9" size 10,3.8
set output "neb_profile.pdf"
set grid
set multiplot layout 1,2
set title "Energy profile"
set xlabel "reaction coordinate (Ang)"
set ylabel "E - E(initial) (eV)"
set key top left font ",8"
plot "spline_0.dat" using 1:2 with lines lw 2 lc rgb "#2a6fdb" notitle, \
     "band_0.dat" using 2:3 with points pt 7 ps 0.8 lc rgb "#2a6fdb" title "fine-tuned: 0.308 eV", \
     "spline_1.dat" using 1:2 with lines lw 2 lc rgb "#d9480f" notitle, \
     "band_1.dat" using 2:3 with points pt 7 ps 0.8 lc rgb "#d9480f" title "MACE-MP-0 medium: 0.301 eV"
set title "NEB convergence"
set xlabel "optimizer step"
set ylabel "residual force (eV/Ang)"
set logscale y
set key top right font ",8"
plot "convergence_0.dat" using 1:3 with lines lw 2 lc rgb "#2a6fdb" title "fine-tuned", \
     "convergence_1.dat" using 1:3 with lines lw 2 lc rgb "#d9480f" title "MACE-MP-0 medium", \
     0.05 with lines dt 2 lc rgb "#666666" title "--fmax"
unset multiplot
