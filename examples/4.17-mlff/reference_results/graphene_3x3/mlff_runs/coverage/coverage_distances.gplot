# --- STB Plot Configuration ---
# Generated by stb-mlff
reset
set terminal pdfcairo enhanced color font "Arial,14" size 7,5
set output "coverage_distances.pdf"

set title "Interatomic distances sampled (stb-mlff)"
set xlabel "Distance (Ang)"
set ylabel "Neighbours per atom per Ang"
set grid lc rgb "#dddddd"
set key top left opaque
set xrange [0:6]
# reference neighbour shells
set arrow from 1.43, graph 0 to 1.43, graph 1 nohead dt 3 lw 1 lc rgb "#888888"
set arrow from 2.48, graph 0 to 2.48, graph 1 nohead dt 3 lw 1 lc rgb "#888888"
set arrow from 2.87, graph 0 to 2.87, graph 1 nohead dt 3 lw 1 lc rgb "#888888"
set arrow from 3.79, graph 0 to 3.79, graph 1 nohead dt 3 lw 1 lc rgb "#888888"
set arrow from 4.30, graph 0 to 4.30, graph 1 nohead dt 3 lw 1 lc rgb "#888888"
set arrow from 4.97, graph 0 to 4.97, graph 1 nohead dt 3 lw 1 lc rgb "#888888"
set arrow from 5.17, graph 0 to 5.17, graph 1 nohead dt 3 lw 1 lc rgb "#888888"
set arrow from 5.74, graph 0 to 5.74, graph 1 nohead dt 3 lw 1 lc rgb "#888888"
plot "coverage_distances.dat" using 1:3 with lines lw 2 lc rgb "#2255cc" title "training", "" using 1:4 with lines lw 2 dt 2 lc rgb "#cc5522" title "test", NaN with lines dt 3 lw 1 lc rgb "#888888" title "reference shells"
