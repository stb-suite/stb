# --- STB Plot Configuration ---
# Generated by stb-mlphonons: gnuplot qha.gplot
set terminal pdfcairo enhanced color font "Arial,10" size 15,8.5
set output "qha.pdf"
set encoding utf8
set grid
set key font ",8"
set multiplot layout 2,3
set xlabel "Volume (Ang^3/cell)"
set ylabel "each curve minus its minimum (meV/atom)"
set title "E(V) and F(V,T): the minimum moves with T"
set key top center
plot for [i=0:4] "qha_fv.dat" index i using 1:2 with lines lw 1.5 title sprintf("F, %s K", word("0 300 600 1000 1500", i+1)), "qha_ev.dat" using 1:2 with points pt 7 lc rgb "black" title "E static"
set xlabel "Temperature (K)"
set ylabel "V (Ang^3/atom)"
set title "Equilibrium volume"
plot "qha.dat" using 1:3 with lines lw 2 lc rgb "#0072B2" notitle
set ylabel "{/Symbol a}_L (10^{-6} K^{-1})"
set title "Linear thermal expansion"
plot "qha.dat" using 1:($5*1e6) with lines lw 2 lc rgb "#0072B2" notitle
set ylabel "B_T (GPa)"
set title "Isothermal bulk modulus"
plot "qha.dat" using 1:6 with lines lw 2 lc rgb "#0072B2" notitle
set key bottom right
set ylabel "k_B/atom"
set title "Heat capacity"
plot "qha.dat" using 1:($7/8/8.314462618) with lines lw 2 lc rgb "#D55E00" title "C_P", "" using 1:($8/8/8.314462618) with lines lw 2 dt 2 lc rgb "#0072B2" title "C_V at V_0", 3 with lines dt 3 lc rgb "gray" notitle
set ylabel "{/Symbol g}"
set title "Average Grueneisen parameter"
plot "qha.dat" using 1:9 with lines lw 2 lc rgb "#0072B2" notitle
unset multiplot
