# NEB test fixture: 2x2 graphene supercell (8 C) with a single H adsorbate
# near one hollow-ish site -- "initial" endpoint of a toy H-diffusion path,
# paired with final.fdf (same lattice/composition, H at a different in-
# plane position). Not a physically converged adsorption geometry, only
# meant to exercise stb-neb/stb-nebAnalysis's mechanics.

NumberOfSpecies    2
NumberofAtoms      9

%block ChemicalSpeciesLabel
 1   6   C
 2   1   H
%endblock ChemicalSpeciesLabel

LatticeConstant 1.0 Ang

AtomicCoordinatesFormat  Fractional

%block LatticeVectors
  4.9200000000   0.0000000000   0.0000000000
 -2.4600000000   4.2608448780   0.0000000000
  0.0000000000   0.0000000000  20.0000000000
%endblock LatticeVectors

%block AtomicCoordinatesAndAtomicSpecies
 0.000000000   0.000000000   0.500000000   1
 0.500000000   0.000000000   0.500000000   1
 0.000000000   0.500000000   0.500000000   1
 0.500000000   0.500000000   0.500000000   1
 0.166666667   0.333333333   0.500000000   1
 0.666666667   0.333333333   0.500000000   1
 0.166666667   0.833333333   0.500000000   1
 0.666666667   0.833333333   0.500000000   1
 0.250000000   0.150000000   0.600000000   2
%endblock AtomicCoordinatesAndAtomicSpecies
