# --- STB Plot Configuration ---
# Generated by stb-mlelastic: gnuplot stress_strain.gplot
set terminal pdfcairo enhanced color font "Arial,9" size 12.6,6.8
set output "stress_strain.pdf"
set grid
set key top left font ",7"
set multiplot layout 2,3
set xlabel "engineering strain (%)"
set title "xx (C11)"
set ylabel "stress (GPa)"
plot "stress_strain_0.dat" index 0 using ($3*100):4 with points pt 7 ps 0.6 lc rgb "#2a6fdb" title "MACE-MP-0 medium", \
     57.472830*x/100 + -0.004583 with lines dt 2 lc rgb "#2a6fdb" title "C = 57.5"
set title "yy (C22)"
set ylabel "stress (GPa)"
plot "stress_strain_0.dat" index 1 using ($3*100):5 with points pt 7 ps 0.6 lc rgb "#2a6fdb" title "MACE-MP-0 medium", \
     57.456430*x/100 + -0.001883 with lines dt 2 lc rgb "#2a6fdb" title "C = 57.5"
set title "zz (C33)"
set ylabel "stress (GPa)"
plot "stress_strain_0.dat" index 2 using ($3*100):6 with points pt 7 ps 0.6 lc rgb "#2a6fdb" title "MACE-MP-0 medium", \
     65.112774*x/100 + -0.010156 with lines dt 2 lc rgb "#2a6fdb" title "C = 65.1"
set title "yz (C44)"
set ylabel "stress (GPa)"
plot "stress_strain_0.dat" index 3 using ($3*100):7 with points pt 7 ps 0.6 lc rgb "#2a6fdb" title "MACE-MP-0 medium", \
     13.040562*x/100 + -0.000000 with lines dt 2 lc rgb "#2a6fdb" title "C = 13.0"
set title "xz (C55)"
set ylabel "stress (GPa)"
plot "stress_strain_0.dat" index 4 using ($3*100):8 with points pt 7 ps 0.6 lc rgb "#2a6fdb" title "MACE-MP-0 medium", \
     13.040528*x/100 + 0.000000 with lines dt 2 lc rgb "#2a6fdb" title "C = 13.0"
set title "xy (C66)"
set ylabel "stress (GPa)"
plot "stress_strain_0.dat" index 5 using ($3*100):9 with points pt 7 ps 0.6 lc rgb "#2a6fdb" title "MACE-MP-0 medium", \
     13.529369*x/100 + 0.000000 with lines dt 2 lc rgb "#2a6fdb" title "C = 13.5"
unset multiplot
