# Auto-generated -- keeps the cell fixed (see examples/4.8-adsorption/
# README.md for why).
MD.VariableCell false
# Auto-generated -- forces a single-point evaluation (no relaxation): this
# folder is one independent, uncoupled sample point, not something SIESTA
# should be moving on its own.
MD.TypeOfRun          CG
MD.Steps              0
# Auto-generated by stb-chargediffPrep -- forces the same real-space grid
# resolution as the combined system, so every fragment's .RHO ends up on
# an identical grid and can be subtracted point-by-point (see
# stb-chargediffPrep's own module docstring for why this is mandatory).
MeshCutoff          300 Ry
# Auto-generated by stb-chargediffPrep -- SIESTA must write the .RHO file
# for stb-chargediffAnalysis to read.
SaveRho             true
# Auto-generated -- forces spin-polarized SCF (see write_reference_folder's
# force_spin docstring for why).
Spin                polarized
# Auto-generated -- forces the slab dipole correction (see write_reference_folder's
# force_dipole docstring for why).
Slab.DipoleCorrection      .true.
