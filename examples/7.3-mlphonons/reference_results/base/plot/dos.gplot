# --- STB Plot Configuration ---
# Generated by stb-mlphonons: gnuplot dos.gplot
set terminal pdfcairo enhanced color font "Arial,10" size 7.5,4.5
set output "dos.pdf"
set encoding utf8
set grid
set key font ",8"
set xlabel "Frequency (THz)"
set ylabel "DOS (states/THz/cell)"
set title "Phonon density of states"
plot "dos_0.dat" using 1:2 with lines lw 2 lc rgb "#0072B2" title "Fine-tuned (total)", \
     "dos_1.dat" using 1:2 with lines lw 2 lc rgb "#D55E00" title "Foundation (medium) (total)"
