# Tutorial fixture for example 2.2 (stb-supercell): graphene monolayer,
# primitive 2-atom hexagonal cell (a = 2.46 Ang, vacuum ~20 Ang along c).
# Used for the full row-major 3x3 matrix path -- the sqrt(3)xsqrt(3)R30
# reconstruction cell, a classic non-orthogonal supercell transformation on
# a 2D material (adsorbate superlattices, e.g. a 1/3-monolayer coverage on
# graphene, are commonly built on exactly this enlarged cell).

NumberOfSpecies    1
NumberofAtoms      2

%block ChemicalSpeciesLabel
 1   6   C
%endblock ChemicalSpeciesLabel

LatticeConstant 1.0 Ang

AtomicCoordinatesFormat  Fractional

%block LatticeVectors
  2.4600000000   0.0000000000   0.0000000000
 -1.2300000000   2.1304224390   0.0000000000
  0.0000000000   0.0000000000  20.0000000000
%endblock LatticeVectors

%block AtomicCoordinatesAndAtomicSpecies
 0.000000000   0.000000000   0.500000000   1
 0.333333333   0.666666667   0.500000000   1
%endblock AtomicCoordinatesAndAtomicSpecies
