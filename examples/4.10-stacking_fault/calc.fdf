SystemLabel      siesta
SystemName       siesta

%include structure.fdf

PAO.BasisType       split
PAO.BasisSize       DZP
PAO.EnergyShift     0.02 Ry

kgrid.MonkhorstPack   [1  1  1]
Mesh.CutOff           200  Ry
FilterCutoff          150  Ry

XC.Functional       GGA
XC.Authors          PBE

Spin                non-polarized

# Whatever MD.TypeOfRun/MD.Steps you put here is irrelevant for Stage 1
# (stb-stackingfault): every shift_II_JJ/ folder gets its OWN
# config_extra.fdf, %include-d ahead of this file, that forces the actual
# relaxation behavior according to --mode (1: restricted CG, z only; 2/3:
# single-point) -- see the README's Stage 1 section.
