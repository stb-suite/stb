# 1D system: an infinite linear carbon chain (carbyne-like).
# Periodic along a (1.30 Ang atom spacing); b and c are vacuum-padded
# (20 Ang each), far above stb-inputfile's vacuum-detection threshold
# (10 Ang) -- so only the a axis is treated as genuinely periodic.
# (Same fixture used by test/1-inputs/3-k-path/example_1D_chain.fdf.)

NumberOfSpecies    1
NumberofAtoms      1

%block ChemicalSpeciesLabel
 1   6   C
%endblock ChemicalSpeciesLabel

LatticeConstant 1.0 Ang

AtomicCoordinatesFormat  Ang

%block LatticeVectors
 1.3000000000    0.0000000000    0.0000000000
 0.0000000000   20.0000000000    0.0000000000
 0.0000000000    0.0000000000   20.0000000000
%endblock LatticeVectors

%block AtomicCoordinatesAndAtomicSpecies
 0.0000000000   10.0000000000   10.0000000000   1
%endblock AtomicCoordinatesAndAtomicSpecies
