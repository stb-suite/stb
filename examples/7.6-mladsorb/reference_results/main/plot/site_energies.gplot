# --- STB Plot Configuration ---
# Generated by stb-mladsorb: gnuplot site_energies.gplot
set terminal pdfcairo enhanced color font "Arial,9" size 6,4
set output "site_energies.pdf"
set grid
set style fill solid
set boxwidth 0.3
set ylabel "E_{ads} (eV)"
set title "Distinct minima"
set xtics rotate by -30 font ",7"
set key bottom right font ",7"
plot "minima.dat" using 1:5:xtic(sprintf("%s #%d %s", stringcolumn(2), $3, stringcolumn(4))) with boxes fs solid 0.7 lc rgb "#1f77b4" title "fine-tuned", \
     "minima_foundation.dat" using ($1+0.3):5 with boxes fs solid 0.5 lc rgb "#ff7f0e" title "MACE-MP-0 medium (its own ranking)"
