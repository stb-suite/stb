# --- STB Plot Configuration ---
# Generated by stb-mlphonons: gnuplot bands.gplot
set terminal pdfcairo enhanced color font "Arial,10" size 9,5.2
set output "bands.pdf"
set encoding utf8
set grid
set key font ",8"
set xtics ("{/Symbol G}" 0.000000, "X" 0.182474, "W" 0.273711, "K" 0.338225, "{/Symbol G}" 0.531768, "L" 0.689795, "U" 0.801537, "W" 0.866051, "L" 0.995079, "K" 1.106821, "U" 1.106821, "X" 1.171336)
set grid xtics
set ylabel "Frequency (THz)"
set y2label "cm^{-1}"
set ytics nomirror
set y2tics 100 format "%.0f"
set link y2 via y*33.35641 inverse y/33.35641
set xrange [0.000000:1.171336]
set key bottom right
set title "Phonon band structure"
plot for [i=2:7] "bands_0.dat" using 1:i with lines lw 1.2 lc rgb "#0072B2" title (i==2 ? "Fine-tuned" : ""), \
     for [i=2:7] "bands_1.dat" using 1:i with lines lw 1.2 lc rgb "#D55E00" title (i==2 ? "Foundation (medium)" : ""), 0 with lines dt 2 lc rgb "gray" notitle
