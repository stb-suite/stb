# NEB site-selection test fixture: same bare 2-atom graphene primitive cell as
# ../../8-adsorption/prep/structure.fdf, except the slab sits near the cell
# boundary (frac z=0.02) instead of centered (frac z=0.5) -- exercises
# stb-nebSites' center_slab_in_vacuum recentering step (a real bug fix: a slab
# left near frac z=0 risks an atom wrapping to frac z~1 during SIESTA relaxation,
# reading as a spurious huge displacement to anything comparing site_A vs site_B).

NumberOfSpecies    1
NumberofAtoms      2

%block ChemicalSpeciesLabel
 1   6   C
%endblock ChemicalSpeciesLabel

LatticeConstant 1.0 Ang

AtomicCoordinatesFormat  Fractional

%block LatticeVectors
 2.46000000   0.00000000   0.00000000
 -1.23000000   2.13042244   0.00000000
 0.00000000   0.00000000   20.00000000
%endblock LatticeVectors

%block AtomicCoordinatesAndAtomicSpecies
  0.00000000   0.00000000   0.02000000   1
  0.33333333   0.66666667   0.02000000   1
%endblock AtomicCoordinatesAndAtomicSpecies
