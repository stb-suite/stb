# --- STB Plot Configuration ---
# Generated by stb-mladsorb: gnuplot top_view.gplot
set terminal pdfcairo enhanced color font "Arial,9" size 6,5
set output "top_view.pdf"
set grid
set size ratio -1
set xrange [-1.00:12.63]
set yrange [-1.00:7.71]
set xlabel "x (Ang)"
set ylabel "y (Ang)"
set title "Top view: substrate, sites, minima"
set key outside right font ",7"
plot "substrate.dat" using 1:($3==2?$2:1/0) with points pt 7 ps 1.2 lc rgb "#777777" title "L2", \
     "substrate.dat" using 1:($3==1?$2:1/0) with points pt 7 ps 2.0 lc rgb "#222222" title "L1", \
     "cell.dat" using 1:2 with lines lc rgb "black" notitle, \
     "sites.dat" using 1:2:3 with points pt 6 ps 1.2 lc variable title "sites (colour: slot)", \
     "minima_xy.dat" using 1:2 with points pt 3 ps 2.5 lc rgb "#d4a017" title "minima", \
     "minima_xy.dat" using 1:2:3 with labels offset 1,1 notitle
