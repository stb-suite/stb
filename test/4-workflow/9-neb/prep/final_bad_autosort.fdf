# NEB test fixture: same as final.fdf, except one substrate carbon atom
# (index 3) is shifted 0.6 Ang -- exercises the graceful [ERROR] path when
# --autosort-tol is too tight to confidently match atoms between --initial
# and --final (a real crash found live and fixed: this used to leak a raw
# pymatgen ValueError/traceback instead of a clear, actionable message).

NumberOfSpecies    2
NumberofAtoms      9

%block ChemicalSpeciesLabel
 1   6   C
 2   1   H
%endblock ChemicalSpeciesLabel

LatticeConstant 1.0 Ang

AtomicCoordinatesFormat  Fractional

%block LatticeVectors
 4.92000000   0.00000000   0.00000000
 -2.46000000   4.26084488   0.00000000
 0.00000000   0.00000000   20.00000000
%endblock LatticeVectors

%block AtomicCoordinatesAndAtomicSpecies
  0.00000000   0.00000000   0.50000000   1
  0.50000000   0.00000000   0.50000000   1
  0.00000000   0.50000000   0.50000000   1
  0.62195122   0.50000000   0.50000000   1
  0.16666667   0.33333333   0.50000000   1
  0.66666667   0.33333333   0.50000000   1
  0.16666667   0.83333333   0.50000000   1
  0.66666667   0.83333333   0.50000000   1
  0.75000000   0.65000000   0.60000000   2
%endblock AtomicCoordinatesAndAtomicSpecies
