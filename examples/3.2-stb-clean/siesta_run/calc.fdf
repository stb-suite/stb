# Bulk Si, primitive cell: variable-cell CG relaxation, then bands, DOS/PDOS and the density
SystemLabel      si
SystemName       Si-bulk-2
%include structure.fdf

PAO.BasisSize       DZP
PAO.EnergyShift     0.01 Ry
Mesh.Cutoff         200 Ry
%block kgrid.MonkhorstPack
 6 0 0 0.5
 0 6 0 0.5
 0 0 6 0.5
%endblock kgrid.MonkhorstPack
XC.Functional       GGA
XC.Authors          PBE

SCF.DM.Tolerance    1.0d-5
DM.UseSaveDM        true          # a rerun reuses si.DM if it is there
MD.UseSaveXV        true          # ... and the geometry in si.XV

MD.TypeOfRun        CG
MD.VariableCell     true
MD.NumCGsteps       20
MD.MaxForceTol      0.01 eV/Ang
MD.MaxStressTol     0.1 GPa

BandLinesScale      ReciprocalLatticeVectors
%block BandLines < bandlines.txt
%block ProjectedDensityOfStates
 -15.0 5.0 0.05 1000 eV
%endblock ProjectedDensityOfStates
SaveRho             true
SaveTotalPotential  true
WriteMullikenPop    1
