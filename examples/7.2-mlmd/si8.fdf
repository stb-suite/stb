# Bulk silicon, conventional diamond cell (8 atoms), at the lattice constant SIESTA relaxes it to with the
# level of theory the model in model/ was trained on (PBE, DZP, PAO.EnergyShift 0.01 Ry, Mesh.Cutoff 300 Ry,
# k 6x6x6): a = 5.48024 Ang. Experiment gives 5.431 Ang at 300 K -- PBE overestimates it by ~0.9 %.
# Every MD in this example starts from this cell or a supercell of it (stb-supercell -d N N N).
NumberOfSpecies 1
NumberOfAtoms 8
%block ChemicalSpeciesLabel
 1 14 Si
%endblock ChemicalSpeciesLabel
LatticeConstant 1.0 Ang
%block LatticeVectors
 5.48023800 0.00000000 0.00000000
 0.00000000 5.48023800 0.00000000
 0.00000000 0.00000000 5.48023800
%endblock LatticeVectors
AtomicCoordinatesFormat Fractional
%block AtomicCoordinatesAndAtomicSpecies
 0.00000000 0.00000000 0.00000000 1
 0.25000000 0.25000000 0.25000000 1
 0.00000000 0.50000000 0.50000000 1
 0.25000000 0.75000000 0.75000000 1
 0.50000000 0.00000000 0.50000000 1
 0.75000000 0.25000000 0.75000000 1
 0.50000000 0.50000000 0.00000000 1
 0.75000000 0.75000000 0.25000000 1
%endblock AtomicCoordinatesAndAtomicSpecies
