# --- STB Plot Configuration ---
# Generated by stb-mladsorb: gnuplot binding_curve.gplot
set terminal pdfcairo enhanced color font "Arial,9" size 6,4
set output "binding_curve.pdf"
set grid
set xlabel "anchor height above layer 1 (Ang)"
set ylabel "E_{ads} (eV)"
set title "Binding curve at fixed height"
set key top right font ",7"
plot "binding_curve.dat" index 0 using 1:($5==0?$2:1/0) with linespoints pt 7 lc rgb "#1f77b4" title "Si #1 ontop", \
     "binding_curve.dat" index 1 using 1:($5==0?$2:1/0) with linespoints pt 7 lc rgb "#ff7f0e" title "Si #2 ontop", \
     "binding_curve.dat" index 2 using 1:($5==0?$2:1/0) with linespoints pt 7 lc rgb "#2ca02c" title "Si #3 bridge", \
     "binding_curve.dat" index 3 using 1:($5==0?$2:1/0) with linespoints pt 7 lc rgb "#d62728" title "Si #4 bridge", \
     "binding_curve.dat" index 4 using 1:($5==0?$2:1/0) with linespoints pt 7 lc rgb "#9467bd" title "Si #5 bridge", \
     "binding_curve.dat" index 5 using 1:($5==0?$2:1/0) with linespoints pt 7 lc rgb "#8c564b" title "Si #6 bridge"
