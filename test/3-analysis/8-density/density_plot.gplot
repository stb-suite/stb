# --- STB Plot Configuration ---
# Generated by plotdensity.py
set terminal pdfcairo enhanced color font "Arial,14" size 6,5
set output "density_plot.pdf"

set title "Charge Density Slice (Z=4.12 A)"
set xlabel "X (Angstrom)"
set ylabel "Y (Angstrom)"
set cblabel "Rho (e/Ang^3)"
set size ratio -1
set tics out nomirror
set pm3d map
set pm3d interpolate 10,10  # Smoothing
set palette defined (0 "#000099", 1 "#2255cc", 2 "#ffffff", 3 "#cc5522", 4 "#990000")
splot "density_plot.dat" using 1:2:4 with pm3d
