# --- STB Plot Configuration ---
# Generated by stb-mlelastic: gnuplot stress_strain.gplot
set terminal pdfcairo enhanced color font "Arial,9" size 12.6,6.8
set output "stress_strain.pdf"
set grid
set key top left font ",7"
set multiplot layout 2,3
set xlabel "engineering strain (%)"
set title "xx (C11)"
set ylabel "stress (GPa)"
plot "stress_strain_0.dat" index 0 using ($3*100):4 with points pt 7 ps 0.6 lc rgb "#2a6fdb" title "fine-tuned", \
     144.877656*x/100 + -0.000433 with lines dt 2 lc rgb "#2a6fdb" title "C = 144.9", \
     "stress_strain_1.dat" index 0 using ($3*100):4 with points pt 7 ps 0.6 lc rgb "#d9480f" title "MACE-MP-0 medium", \
     102.897230*x/100 + -0.010481 with lines dt 2 lc rgb "#d9480f" title "C = 102.9"
set title "yy (C22)"
set ylabel "stress (GPa)"
