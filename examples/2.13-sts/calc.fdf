SystemName Graphene
SystemLabel Graphene

PAO.BasisSize DZP
PAO.EnergyShift 0.02 Ry

%include structure.fdf

kgrid_Monkhorst_Pack [ 4 4 1 ]

MeshCutOff 250 Ry
MaxSCFIterations 200
XC.Functional GGA
XC.Authors PBE
Spin non-polarized
SCF.Mixer.Weight 0.2
SCF.DM.Tolerance 1.0d-5 eV
ElectronicTemperature 25.0 meV

MD.Steps 0

WriteCoorInitial .true.
SaveRho .false.

WriteWaveFunctions T
WaveFuncKPointsScale ReciprocalLatticeVectors
%block WaveFuncKPoints
 0.0000  0.0000  0.0000
 0.2500  0.0000  0.0000
 0.5000  0.0000  0.0000
 0.0000  0.2500  0.0000
 0.2500  0.2500  0.0000
 0.5000  0.2500  0.0000
 0.0000  0.5000  0.0000
 0.2500  0.5000  0.0000
 0.5000  0.5000  0.0000
%endblock WaveFuncKPoints
