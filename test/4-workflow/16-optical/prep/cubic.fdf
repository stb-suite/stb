# Fixture: simple-cubic single-atom lattice (a = 3.0 Ang), 3D bulk, no
# vacuum axis -- small/fast fixture for stb-optical/stb-opticalAnalysis'
# own test suite (borrowed from test/4-workflow/15-gqca/prep/, same
# lattice, unrelated physics here).

NumberOfSpecies    1
NumberofAtoms      1

%block ChemicalSpeciesLabel
 1   11   Na
%endblock ChemicalSpeciesLabel

LatticeConstant 1.0 Ang

AtomicCoordinatesFormat  Fractional

%block LatticeVectors
 3.0000000000   0.0000000000   0.0000000000
 0.0000000000   3.0000000000   0.0000000000
 0.0000000000   0.0000000000   3.0000000000
%endblock LatticeVectors

%block AtomicCoordinatesAndAtomicSpecies
 0.000000000   0.000000000   0.000000000   1
%endblock AtomicCoordinatesAndAtomicSpecies
