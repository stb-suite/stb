# Vacancy-migration NEB endpoint (7-atom Si, one atom removed from the
# conventional 8-atom diamond-cubic cell, a=5.43 Ang -- same base fixture
# as test/5-mlsimulations/3-mlelastic/si8.fdf). This "initial" endpoint has
# the vacancy at the (0,0,0) site's nearest neighbor (0.25,0.25,0.25) --
# NOT removed here; see vac_final.fdf for where the neighboring atom ends
# up after the hop (both endpoints keep every OTHER atom at the exact same
# index/position, so stb-mlneb's atom correspondence is unambiguous without
# relying on --autosort-tol).
NumberOfSpecies    1
NumberofAtoms      7

%block ChemicalSpeciesLabel
 1   14   Si
%endblock ChemicalSpeciesLabel

LatticeConstant 1.0 Ang

AtomicCoordinatesFormat  Fractional

%block LatticeVectors
 5.43000000   0.00000000   0.00000000
 0.00000000   5.43000000   0.00000000
 0.00000000   0.00000000   5.43000000
%endblock LatticeVectors

%block AtomicCoordinatesAndAtomicSpecies
  0.50000000   0.00000000   0.50000000   1
  0.00000000   0.00000000   0.00000000   1
  0.25000000   0.75000000   0.75000000   1
  0.75000000   0.25000000   0.75000000   1
  0.00000000   0.50000000   0.50000000   1
  0.50000000   0.50000000   0.00000000   1
  0.75000000   0.75000000   0.25000000   1
%endblock AtomicCoordinatesAndAtomicSpecies
