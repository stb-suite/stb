# --- STB Plot Configuration ---
# Generated by stb-mlmd: gnuplot si216_md.gplot
set terminal pdfcairo enhanced color font "Arial,10" size 15,8.2
set output "si216_md.pdf"
set multiplot layout 2,3 title "stb-mlmd NVT 300 K -- Si216 (216 atoms), MACE-MP-0 medium"
set grid
set key top right font ",8"

set xlabel "time (ps)"
set ylabel "temperature (K)"
set title "Temperature"
plot "si216_md_thermo.dat" using ($1/1000):2 with lines lw 1 lc rgb "#0072B2" title "T(t)", 300 with lines dt 2 lc rgb "#777777" title "target"
set ylabel "energy - mean (meV/atom)"
set title "Energies"
plot "si216_md_thermo.dat" using ($1/1000):(($3-(-5.30288646))*1000) with lines lw 1 lc rgb "#0072B2" title "E_{pot}", "" using ($1/1000):(($5-(-5.26431534))*1000) with lines lw 1.5 lc rgb "#D55E00" title "E_{tot}"
set ylabel "pressure (GPa)"
set title "Pressure"
plot "si216_md_thermo.dat" using ($1/1000):6 with lines lw 1 lc rgb "#009E73" title "P(t)"
set ylabel "shortest distance (Ang)"
set title "Closest pair"
plot "si216_md_thermo.dat" using ($1/1000):11 with lines lw 1 lc rgb "#CC79A7" title "d_{min}"
set xlabel "r (Ang)"
set ylabel "g(r)"
set title "Radial distribution function"
plot "si216_md_rdf.dat" using 1:2 with lines lw 1.5 lc rgb "#0072B2" title "g(r)"
set xlabel "lag time (ps)"
set ylabel "MSD (Ang^2)"
set title "Mean-square displacement"
plot "si216_md_msd.dat" using ($1/1000):2 with lines lw 1.5 lc rgb "#0072B2" title "all atoms"
unset multiplot
